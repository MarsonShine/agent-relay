{
  "name": "agent-relay",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.2",
    "npm": "11.14.1"
  },
  "packageManager": "npm@11.14.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test examples package.json tsconfig*.json .github/workflows/ci.yml",
    "format:check": "prettier --check src test examples package.json tsconfig*.json .github/workflows/ci.yml",
    "test": "node --test --test-concurrency=2 test/*.test.ts scripts/m0/process-probe.test.mts",
    "check": "npm run typecheck && npm run format:check && npm test",
    "start": "node dist/cli.js",
    "prestart": "npm run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "bin": {
    "agent-relay": "dist/cli.js"
  }
}
